# CPU runtime for a local DeepFlipper voice server. No ESP-IDF or GPU needed.
ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.10-slim
FROM ${PYTHON_IMAGE}

ARG DEBIAN_MIRROR=https://mirrors.ustc.edu.cn
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends libopus0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/xiaozhi-esp32-server
ENV PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 LANG=C.UTF-8

# Select CPU wheels first so the shared requirements do not pull CUDA libraries.
RUN --mount=type=cache,target=/root/.cache/pip pip install --upgrade pip setuptools wheel
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch==2.2.2+cpu torchaudio==2.2.2+cpu \
    --extra-index-url https://download.pytorch.org/whl/cpu
COPY main/xiaozhi-server/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
COPY main/xiaozhi-server ./
# Runtime models are downloaded separately and mounted by compose.local.yaml.
CMD ["python", "app.py"]
